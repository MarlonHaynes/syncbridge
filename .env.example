# ==== App ====
PORT=4000
NODE_ENV=development

# ==== Mock toggles ====
# Both default true so the entire system runs with zero real credentials.
# Flip to false (and fill in the real config below) once you have a live
# Salesforce Dev Org / NexCore instance to connect to.
USE_MOCK_SALESFORCE=true
USE_MOCK_NEXCORE=true

# ==== Salesforce (placeholders - fill in after Dev Org signup) ====
SF_INSTANCE_URL=https://placeholder.my.salesforce.com
SF_CLIENT_ID=placeholder_client_id
SF_CLIENT_SECRET=placeholder_client_secret
SF_USERNAME=placeholder@example.com
SF_PASSWORD=placeholder_password
SF_API_VERSION=v60.0

# ==== NexCore (placeholders - you own this system) ====
NEXCORE_API_URL=https://placeholder.nexcore.app
NEXCORE_API_KEY=placeholder_nexcore_key

# ==== Infra ====
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/syncbridge
REDIS_URL=redis://localhost:6379

# ==== Queue tuning ====
QUEUE_MAX_ATTEMPTS=5
QUEUE_BACKOFF_DELAY_MS=2000

# ==== Scheduler ====
# How often the background scheduler auto-triggers a Salesforce poll (ms).
SF_POLL_INTERVAL_MS=30000

# ==== Frontend ====
VITE_API_BASE_URL=http://localhost:4000
