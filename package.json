{
  "name": "syncbridge",
  "private": true,
  "version": "1.0.0",
  "description": "SyncBridge - bidirectional CRM<->ERP integration middleware (portfolio project)",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "postinstall": "npm run build --workspace=shared",
    "build:shared": "npm run build --workspace=shared",
    "dev:server": "npm run dev --workspace=server",
    "dev:worker": "npm run dev:worker --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "migrate": "npm run migrate --workspace=server",
    "seed": "npm run seed --workspace=server",
    "build": "npm run build:shared && npm run build --workspace=server && npm run build --workspace=client",
    "start:server": "npm run start --workspace=server",
    "start:worker": "npm run start:worker --workspace=server"
  },
  "engines": {
    "node": ">=18"
  }
}
